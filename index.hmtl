<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>hvalil // 3D Water Stars</title>
    <style>
        :root {
            --bg-base: #020204;
            --aurora-1: #1a0b2e;
            --aurora-2: #0a1c3d;
            --aurora-3: #3d0a1c;
            --text-main: #ffffff;
            --text-sub: #8a8a93;
            --text-quote: #b0b0b8;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-base);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            position: relative;
            perspective: 1000px;
        }

        /* ФОН */
        .aurora-layer {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: 0;
            overflow: hidden;
        }

        .aurora {
            position: absolute;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.6;
            animation: drift 30s infinite alternate ease-in-out;
        }

        .a1 { width: 500px; height: 500px; background: var(--aurora-1); top: -20%; left: -30%; animation-delay: 0s; }
        .a2 { width: 450px; height: 450px; background: var(--aurora-2); bottom: -20%; right: -20%; animation-delay: -10s; }
        .a3 { width: 400px; height: 400px; background: var(--aurora-3); top: 40%; left: 30%; animation-delay: -20s; opacity: 0.4; }

        @keyframes drift {
            0% { transform: translate3d(0, 0, -100px) scale(1); }
            100% { transform: translate3d(60px, 80px, -50px) scale(1.2); }
        }

        /* КОНТЕЙНЕР ДЛЯ КАПЕЛЬ */
        #stars-container {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: 1;
            overflow: hidden;
            pointer-events: none; 
        }

        /* 3D-КАПЛЯ */
        .water-star {
            position: absolute;
            border-radius: 50%;
            pointer-events: auto;
            cursor: pointer;
            background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.1) 40%, rgba(100, 200, 255, 0.2) 80%, rgba(0, 0, 0, 0) 100%);
            box-shadow: 
                inset 0 0 15px rgba(255, 255, 255, 0.5),
                inset -5px -5px 15px rgba(0, 100, 255, 0.3),
                0 10px 20px rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(2px);
            -webkit-backdrop-filter: blur(2px);
            animation: floatStar linear infinite;
            transition: transform 0.1s;
        }

        .water-star::after {
            content: '';
            position: absolute;
            top: 15%; left: 20%;
            width: 25%; height: 25%;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.8);
            filter: blur(1px);
        }

        @keyframes floatStar {
            0% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(10deg); }
            100% { transform: translateY(0) rotate(0deg); }
        }

        /* ЛОПАНИЕ */
        .water-star.popped {
            animation: pop 0.4s cubic-bezier(0.1, 0.9, 0.2, 1) forwards;
            pointer-events: none;
        }

        @keyframes pop {
            0% { transform: scale(1); opacity: 1; filter: brightness(1); }
            50% { transform: scale(1.6); opacity: 0.8; filter: brightness(2); }
            100% { transform: scale(3); opacity: 0; filter: brightness(3); }
        }

        .splash-ring {
            position: absolute;
            border-radius: 50%;
            border: 2px solid rgba(150, 220, 255, 0.8);
            pointer-events: none;
            transform: translate(-50%, -50%);
            animation: splash 0.6s ease-out forwards;
            box-shadow: 0 0 15px rgba(150, 220, 255, 0.5);
            z-index: 2;
        }

        @keyframes splash {
            0% { width: 10px; height: 10px; opacity: 1; }
            100% { width: 150px; height: 150px; opacity: 0; }
        }

        /* КАРТОЧКА */
        .glass-card {
            background: linear-gradient(160deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.01) 100%);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            border-radius: 44px;
            padding: 40px 25px;
            width: 90%;
            max-width: 380px;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            z-index: 10;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 
                0 40px 80px -20px rgba(0, 0, 0, 0.9),
                inset 0 1px 1px rgba(255, 255, 255, 0.2),
                inset 0 -1px 1px rgba(0, 0, 0, 0.7);
            opacity: 0;
            transform: translateY(50px) scale(0.94);
            animation: cardAppear 1.5s cubic-bezier(0.19, 1, 0.22, 1) forwards;
        }

        @keyframes cardAppear {
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* ОСТАЛЬНОЙ ДИЗАЙН */
        .avatar-container { position: relative; margin-bottom: 20px; }
        .avatar-ring {
            width: 90px; height: 90px; border-radius: 50%;
            display: flex; justify-content: center; align-items: center;
            position: relative; animation: breathe 7s ease-in-out infinite;
        }
        .avatar-ring::before {
            content: ""; position: absolute; inset: 0; border-radius: 50%; padding: 2px;
            background: conic-gradient(from 0deg, transparent, rgba(150,220,255,0.5), transparent, rgba(150,220,255,0.5), transparent);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor; mask-composite: exclude;
            animation: spinRing 10s linear infinite;
        }
        @keyframes spinRing { to { transform: rotate(360deg); } }
        @keyframes breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.05); } }
        .avatar-inner {
            width: 76px; height: 76px; background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.1), rgba(255,255,255,0.01));
            border-radius: 50%; display: flex; justify-content: center; align-items: center;
            font-size: 30px; font-weight: 300; color: rgba(255, 255, 255, 0.9);
            box-shadow: inset 0 0 20px rgba(255,255,255,0.05);
        }

        h1 {
            font-size: 2.4rem; font-weight: 700; letter-spacing: 1px; margin-bottom: 4px; text-transform: lowercase;
            background: linear-gradient(270deg, #ffffff, #7a7a85, #ffffff, #7a7a85, #ffffff);
            background-size: 300% 300%; -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            animation: shimmer 7s linear infinite;
        }
        @keyframes shimmer { 0% { background-position: 0% 50%; } 100% { background-position: 300% 50%; } }

        .status-badge {
            font-size: 0.6rem; color: var(--text-sub); letter-spacing: 3px; text-transform: uppercase;
            margin-bottom: 25px; opacity: 0.7; display: flex; align-items: center; gap: 6px;
        }
        .status-dot {
            width: 5px; height: 5px; background: #4ade80; border-radius: 50%;
            box-shadow: 0 0 10px #4ade80; animation: pulseDot 2s infinite;
        }
        @keyframes pulseDot { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

        .quote-block {
            width: 100%; background: rgba(0, 0, 0, 0.3); border-radius: 20px; padding: 18px 15px;
            margin-bottom: 25px; border: 1px solid rgba(255, 255, 255, 0.05);
            box-shadow: inset 0 2px 10px rgba(0,0,0,0.5); position: relative; overflow: hidden;
        }
        .quote-block::before {
            content: "“"; position: absolute; top: -10px; left: 10px; font-size: 4rem;
            font-family: Georgia, serif; color: rgba(255,255,255,0.05);
        }
        .quote-text {
            font-size: 0.8rem; line-height: 1.5; color: var(--text-quote); font-style: italic;
            text-align: center; position: relative; z-index: 2; margin-bottom: 8px;
        }
        .quote-author {
            display: block; text-align: right; font-size: 0.65rem; letter-spacing: 2px;
            color: rgba(255,255,255,0.4); text-transform: uppercase; font-style: normal;
            position: relative; z-index: 2;
        }

        .links { width: 100%; display: flex; flex-direction: column; gap: 12px; }
        .btn {
            display: flex; align-items: center; justify-content: center; gap: 12px; width: 100%;
            padding: 16px; border-radius: 18px; text-decoration: none; color: #fff;
            font-size: 0.95rem; font-weight: 600; letter-spacing: 0.5px;
            background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 20px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.1);
            transition: all 0.4s ease; position: relative; overflow: hidden;
        }
        .btn::after {
            content: ""; position: absolute; top: 0; left: -120%; width: 40%; height: 100%;
            background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.2) 50%, rgba(255,255,255,0) 100%);
            transform: skewX(-30deg); transition: left 0.6s ease;
        }
        .btn:active::after { left: 220%; }
        .btn:active { transform: scale(0.96); }
        .btn svg { width: 20px; height: 20px; fill: currentColor; opacity: 0.8; }
        .btn-tg:hover, .btn-tg:active { background: rgba(34, 158, 217, 0.15); border-color: rgba(34, 158, 217, 0.4); box-shadow: 0 10px 30px -10px rgba(34, 158, 217, 0.6); }
        .btn-tt:hover, .btn-tt:active { background: rgba(254, 44, 85, 0.15); border-color: rgba(254, 44, 85, 0.4); box-shadow: 0 10px 30px -10px rgba(254, 44, 85, 0.6); }

        .footer { margin-top: 30px; font-size: 0.6rem; color: rgba(255, 255, 255, 0.2); letter-spacing: 2px; text-transform: uppercase; }
    </style>
</head>
<body>

    <div class="aurora-layer">
        <div class="aurora a1"></div>
        <div class="aurora a2"></div>
        <div class="aurora a3"></div>
    </div>

    <div id="stars-container"></div>

    <div class="glass-card">
        <div class="avatar-container">
            <div class="avatar-ring">
                <div class="avatar-inner">H</div>
            </div>
        </div>

        <h1>hvalil</h1>
        
        <div class="status-badge">
            <span class="status-dot"></span>
            Digital Existentialist
        </div>

        <div class="quote-block">
            <div class="quote-text">Эгоизм есть закон перспективы в ощущениях, по которому ближайшее предстает большим и тяжелым, тогда как по мере удаления все вещи убывают в величине и весе.</div>
            <span class="quote-author">— Фридрих Ницше</span>
        </div>

        <div class="links">
            <a href="https://t.me/hvalil" class="btn btn-tg" target="_blank">
                <svg viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
                Telegram
            </a>
            <a href="https://tiktok.com/@ТВОЯ_ССЫЛКА" class="btn btn-tt" target="_blank">
                <svg viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                TikTok
            </a>
        </div>

        <div class="footer">© hvalil</div>
    </div>

    <script>
        (function initStars() {
            const container = document.getElementById('stars-container');
            if (!container) return;
            
            const starCount = 20;

            function createStar() {
                const star = document.createElement('div');
                star.className = 'water-star';

                const size = Math.random() * 30 + 20;
                star.style.width = `${size}px`;
                star.style.height = `${size}px`;
                star.style.left = `${Math.random() * 90 + 5}%`;
                star.style.top = `${Math.random() * 90 + 5}%`;
                
                const duration = Math.random() * 5 + 4;
                star.style.animationDuration = `${duration}s`;
                star.style.animationDelay = `-${Math.random() * 5}s`;
                
                const blur = Math.random() * 1.5;
                star.style.filter = `blur(${blur}px)`;

                star.addEventListener('pointerdown', (e) => {
                    e.preventDefault();
                    star.classList.add('popped');

                    const ring = document.createElement('div');
                    ring.className = 'splash-ring';
                    ring.style.left = `${e.clientX}px`;
                    ring.style.top = `${e.clientY}px`;
                    document.body.appendChild(ring);

                    setTimeout(() => { star.remove(); ring.remove(); }, 600);
                    setTimeout(createStar, 800);
                });

                container.appendChild(star);
            }

            for (let i = 0; i < starCount; i++) {
                createStar();
            }
        })();
    </script>
</body>
</html>
